<div class="container-xl container-lg container-md container-sm">
  <h1>Carts</h1>
  <p id="notice"><%= notice %></p>
  <%= link_to("< Back to Categories", {:controller => 'categories',:action => 'index'},class: "btn btn-primary") %>
  <% @count=0 %>
  <% @carts.each do |cart| %>
    <% @count=@count+1 %>
  <%end%>
  <h2>Total Carts : <%= @count %></h2>
  <div class="row py-3">
    <% @carts.each do |cart| %>
      <% @product = Product.find(cart.product_id) %>
      
      <div class="col-md-4 py-3">
        <div class="card">
          <% if @product.avatar.attached?%>
            <%= image_tag @product.avatar , width: "200px" %>
          <%end%>
            <div class="card-body">
                <h5 class="card-title"><%= @product.product_name %></h5>
                <p class="card-text">
                  Price : 
                  <%= @product.Price %>
                  <br>
                  Discription : 
                  <%= @product.Discription %>
                </p>
                  <%= link_to 'Remove from Cart', [:user, cart], method: :delete, data: { confirm: 'Are you sure?' } ,class: "btn btn-primary"%>
                  <%= link_to 'Order Product', new_user_order_path(:product_id => @product.id), class: "btn btn-primary" %>
            </div>
        </div>
      </div>
    <% end %>
  </div>
</div>


<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @carts.each do |cart| %>
      <tr>
        <td><% link_to 'Show', [:user, cart] %></td>
        <td><% link_to 'Edit', edit_user_cart_path(cart) %></td>
        <td><% link_to 'Destroy', [:user, cart], method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<% link_to 'New Cart', new_user_cart_path %>
