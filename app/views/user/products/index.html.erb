<div class="container-xl container-lg container-md container-sm">
<p id="notice"><%= notice %></p>
  <% @category= Category.find(params[:category_id])%>
  <h1><%=@category.Type+"  "%>Products</h1>
  <%= link_to("< Back to Categories", {:controller => 'user/categories',:action => 'index'},class: "btn btn-primary") %>
  <div class="row py-3">
    <% @products.each do |product| %>
      <div class="col-md-4 py-2">
          <div class="card">
              <% if product.avatar.attached?%>
                <%= image_tag product.avatar, width: "100px" %>
              <%end%>
              
              <div class="card-body">
                  <h5 class="card-title"><%= product.product_name %></h5>
                  <p class="card-text">
                    Price : 
                    <%= product.Price %>
                    <br>
                    Discription :
                    <%= product.Discription %>
                    <br>
                    Rented or Order (Status) :
                    <%= product.ren_order %>
                  </p>
                  <% if current_user.present? %>
                    <%= link_to 'Add Dish', new_user_cart_path(:product_id => product.id), class: "btn btn-primary" %>
                  <%end%>

                  <% if product.ren_order == "orders" %>
                    <%#= link_to 'Order Product', new_user_order_path(:product_id => product.id), class: "btn btn-primary" %>
                  <% else %>
                    <%#= link_to 'Rent a Product', new_user_order_path(:product_id => product.id), class: "btn btn-primary" %>
                  <% end %>                    
              </div>
          </div>
      </div>
    <% end %>
    </div>
</div>


<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><% link_to 'Show', [:user, product] %></td>
        <td><% link_to 'Edit', edit_user_product_path(product) %></td>
        <td><% link_to 'Remove', [:user, product], method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<% link_to 'New Product', new_user_product_path %>

