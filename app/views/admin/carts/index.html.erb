<div class="container-xl container-lg container-md container-sm">
  <p id="notice"><%= notice %></p>

  <%= link_to '< Admin Home', admin_admin_home_home_path ,class: "btn btn-primary"%>
  <h1>Admin View All Carts</h1>
  
  <% @count=0 %>
  <% @carts.each do |cart| %>
    <% @count=@count+1 %>
  <%end%>
  <h2>Total Carts : <%= @count %></h2>
  <div class="row py-3">
    <% @carts.each do |cart| %>
      <% @product = Product.find(cart.product_id) %>
      <% @user = User.find(cart.user_id) %>
      <div class="col-md-4 py-3">
      <div class="card">
        <% if @product.avatar.attached?%>
          <%= image_tag @product.avatar , width: "200px" %>
        <%end%>
            <div class="card-body">
                <h5 class="card-title"><%= @product.product_name %></h5>
                <p class="card-text">
                  Price : 
                  <%= @product.Price %>
                  <br>
                  User Email : 
                  <%=@user.email %>
                  <br>
                  Discription : 
                  <%= @product.Discription %>
                </p>
                <%= link_to 'Show', [:admin, cart] ,class: "btn btn-primary"%>
                <%= link_to 'Edit', edit_admin_cart_path(cart) ,class: "btn btn-primary"%></td>
                <%= link_to 'Destroy', [:admin, cart], method: :delete, data: { confirm: 'Are you sure?' } ,class: "btn btn-primary"%></td>
                
            </div>
        </div>
    </div>
  <% end %>
  </div>
</div>

<% link_to 'New Cart', new_admin_cart_path %>
