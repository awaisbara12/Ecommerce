<div class="col-md-4 py-2" id="CategoryRow_<%=category.id%>">
    <div class="card">
        <% if category.avatar.attached?%>
            <%= image_tag category.avatar, width: "100px" %>
        <%end%>
        
        <div class="card-body">
            <h5 class="card-title"><%= category.Type %></h5>
            <p class="card-text">Some quick example text to build on the card title and make up the bulk of
                the card's content.</p>
            <%= link_to 'View Products', admin_products_path(:category_id => category.id), class: "btn btn-primary"%>
            <br>
            <br>
            <% if user_signed_in? %>
                <% if current_user.role =="admin"%>
                <%= link_to 'Show', [:admin, category], class: "btn btn-primary" , data: { bs_toggle: 'modal', bs_target: '#showCategoryModal', remote: true} %>
                <%= link_to 'Edit', edit_admin_category_path(category), class: "btn btn-primary" , data: { bs_toggle: 'modal', bs_target: '#editCategoryModal', remote: true} %>
                <%= link_to 'Destroy', [:admin, category], method: :delete, data: { confirm: 'Are you sure?' , remote: true }, class: "btn btn-primary" %>
                <% end %>
            <% end %>
        </div>
    </div>
</div>