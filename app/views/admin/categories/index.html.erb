<div class="container-xl container-lg container-md container-sm">

  <h1>Categories</h1>
  <%= link_to '< Admin Home', admin_admin_home_home_path ,class: "btn btn-primary"%>
  </br>
  </br>
  <% if user_signed_in? %>
      <% if current_user.role =="admin"%>
        <%= link_to 'New Category', new_admin_category_path, class: "btn btn-primary" , data: { bs_toggle: 'modal', bs_target: '#newCategoryModal', remote: true} %>
      <% end %>
  <% end %>
  <div class="row py-3" id="CategoryIndex">
      <% @categories.each do |category| %>
        <%= render 'category_row', category: category %>
      <% end %>
    </div>
</div>



<div class="modal fade" id="newCategoryModal" tabindex="-1" aria-labelledby="newCategoryModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="newCategoryModalLabel">Add New Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div id="newCategoryForm">
      </div>
    </div>
  </div>
</div>


<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editCategoryModalLabel">Update Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div id="editCategoryForm">
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="showCategoryModal" tabindex="-1" aria-labelledby="showCategoryModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="showCategoryModalLabel">Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div id="showCategoryDetails">
      </div>
    </div>
  </div>
</div>
