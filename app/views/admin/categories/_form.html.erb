<%= form_with(model: [:admin, category], local: false) do |form| %>
  <% if category.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h2>

      <ul>
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="modal-body">
    <div class="mb-3">
      <%= form.label :Type,class: "form-label" %>
      <%= form.text_field :Type ,class: "form-control"%>
    </div>

    <% if @category.avatar.attached?%>
      <div class="card">
          <%= image_tag @category.avatar , width: "100px" %>
      </div>
    <%end%>
    <div class="mb-3">
      <%= form.label :avatar , class: "form-label" %>
      <%= form.file_field :avatar ,class: "form-control"%>
    </div>
  <div>

  <div class="modal-footer">
    <button type="button" class="btn btn-danger close-modal" data-bs-dismiss="modal">Close</button>
    <%= form.submit class: "btn btn-success"%>
  </div>
<% end %>

