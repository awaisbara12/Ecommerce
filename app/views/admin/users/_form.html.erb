<%= form_with(model: [:admin, user], local: false) do |form| %>
  <div class="modal-body">
    <% if user.errors.any? %>
      <div id="error_explanation">
        <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>

        <ul>
          <% user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-label">
      <h5><%= form.label :email,class: "form-label" %></h5><br />
      <%= form.email_field :email, autofocus: true, autocomplete: "email",class: "form-control" %>
    </div>

    <div class="form-label">
      <h5><%= form.label :role,class: "form-label" %></h5><br />
      <%= form.select :role,User.roles.keys,class: "form-control" %>
    </div>
  </div>

  <div class="modal-footer">
    <button type="button" class="btn btn-danger close-modal" data-bs-dismiss="modal">Close</button>
    <%= form.submit class: "btn btn-success"%>
  </div>

  
<% end %>