<tr id="UserRow_<%=user.id%>">
    <td><%= user.role %></td>
    <td><%= user.email %></td>
    <td class="actions">
        <%= link_to 'Show', [:admin, user] , class: "btn btn-primary", data: { bs_toggle: 'modal', bs_target: '#showUserModal', remote: true}%>
        <%= link_to 'Edit', edit_admin_user_path(user) , class: "btn btn-primary", data: { bs_toggle: 'modal', bs_target: '#editUserModal', remote: true}%>
        <%= link_to 'Destroy', [:admin, user], method: :delete, data: { confirm: 'Are you sure?' , remote: true }, class: "btn btn-primary" %>
    </td>
</tr>