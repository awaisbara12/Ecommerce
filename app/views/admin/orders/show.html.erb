<div class="container">
    <p id="notice"><%= notice %></p>

    <p>
    <strong>User:</strong>
    <%= @order.user_id %>
    </p>

    <p>
    <strong>Product:</strong>
    <%= @order.product_id %>
    </p>

    <p>
    <strong>Address:</strong>
    <%= @order.address %>
    </p>

    <p>
    <strong>Price:</strong>
    <%= @order.price %>
    </p>

    <p>
    <strong>Quantity:</strong>
    <%= @order.quantity %>
    </p>
    <%= link_to 'Edit', edit_admin_order_path(@order),class: "btn btn-primary" %> |
    <%= link_to 'Back', admin_orders_path,class: "btn btn-primary" %>
</div>
