<%= form_with(model: [:admin, order], local: true) do |form| %>
  <% if order.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:</h2>

      <ul>
        <% order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :user_id ,class: "form-label"%>
    <%= form.number_field :user_id ,class: "form-control"%>
  </div>

  <div class="mb-3">
    <%= form.label :product_id ,class: "form-label"%>
    <%= form.number_field :product_id ,class: "form-control"%>
  </div>

  <div class="mb-3">
    <%= form.label :address,class: "form-label" %>
    <%= form.text_field :address ,class: "form-control"%>
  </div>

  <div class="mb-3">
    <%= form.label :email ,class: "form-label"%>
    <%= form.text_field :email,class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :price ,class: "form-label"%>
    <%= form.number_field :price,class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :quantity,class: "form-label" %>
    <%= form.number_field :quantity,class: "form-control" %>
  </div>

  <% if user_signed_in? %>
    <% if current_user.role =="admin" || current_user.role =="manager" || current_user.role =="owner"%>
      <div class="mb-3">
        <%= form.label :status,class: "form-label" %>
        <%= form.number_field :status ,class: "form-control" %>
      </div>
    <%end%>
  <%end%>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
