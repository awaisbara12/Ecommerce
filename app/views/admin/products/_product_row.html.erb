<div class="col-md-4 py-2" id="ProductRow_<%=product.id%>">
  <div class="card">
      <% if product.avatar.attached?%>
        <%= image_tag product.avatar, width: "100px" %>
      <%end%>
    
      <div class="card-body">
        <h5 class="card-title"><%= product.product_name %></h5>
        <p class="card-text">
          Price : 
          <%= product.Price %>
          <br>
          Discription :
          <%= product.Discription %>
          <br>
          Rented or Order (Status) :
          <%= product.ren_order %>
        </p>
        <%#= link_to 'Add to Cart', admin_add_to_cart_path(product.id), method: :post, class: "btn btn-primary",remote: true %>
        <br>
        <br>
        <% if user_signed_in? %>
          <% if current_user.role =="admin" || current_user.role =="manager" || current_user.role =="owner"%>
            <%= link_to 'Show', [:admin, product],class: "btn btn-primary", data: { bs_toggle: 'modal', bs_target: '#showProductModal', remote: true} %>
            <%= link_to 'Edit', edit_admin_product_path(product), class: "btn btn-primary" , data: { bs_toggle: 'modal', bs_target: '#editProductModal', remote: true} %>
            <%= link_to 'Remove', [:admin, product], method: :delete, data: { confirm: 'Are you sure?' , remote: true },class: "btn btn-primary" %>
          <% end %>
        <% end %>
      </div>
  </div>
</div>