<%= form_with(model: [:admin, product], local: false) do |form| %>

  <% if product.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="modal-body">

    <% if @product.avatar.attached?%>
      <div class="card">
          <%= image_tag @product.avatar , width: "100px" %>
      </div>
    <%end%>
    
    <div class="mb-3">
      <%= form.label :category_id,class: "form-label" %>
      <%= form.number_field :category_id,class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :product_name,class: "form-label" %>
      <%= form.text_field :product_name,class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :Price,class: "form-label" %>
      <%= form.number_field :Price,class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :Discription,class: "form-label" %>
      <%= form.text_field :Discription,class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :avatar,class: "form-label" %>
      <%= form.file_field :avatar,class: "form-control" %>
    </div>
  </div>

  <div class="modal-footer">
    <button type="button" class="btn btn-danger close-modal" data-bs-dismiss="modal">Close</button>
    <%= form.submit class: "btn btn-success"%>
  </div>
<% end %>
