<div class="col-md-4">
  <div class="card">
  <% if @product.avatar.attached?%>
  <%= image_tag @product.avatar , width: "200px" %>
  <%end%>
      <div class="card-body">
          <h5 class="card-title"><%= @product.product_name %></h5>
          <p class="card-text">
            Price : 
            <%= @product.Price %>
            <br>
            Discription : 
            <%= @product.Discription %>
          </p>
          <%= link_to 'Edit', edit_product_path(@product),class: "btn btn-primary" %>
          <%= link_to 'Back', admin_products_path(:category_id => @product.category_id),class: "btn btn-primary" %>
      </div>
  </div>
</div>
