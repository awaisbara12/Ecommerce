<div class="container-xl container-lg container-md container-sm">
  <% @category= Category.find(params[:category_id])%>
  <h1><%=@category.Type+"  "%>Products</h1>
  <%= link_to("< Back to Categories", admin_categories_path,class: "btn btn-primary") %>
  <br>
  <br>
  <% if user_signed_in? %>
    <% if current_user.role =="admin"%>
      <%= link_to 'Add New Product', new_admin_product_path(:category_id => @category.id), class: "btn btn-primary" , data: { bs_toggle: 'modal', bs_target: '#newProductModal', remote: true} %>
    <% end %>
  <% end %>

  <div class="row py-3" id="ProductIndex">
    <% @products.each do |product| %>
      <%= render 'product_row', product: product %>
    <% end %>
    </div>
</div>


<div class="modal fade" id="newProductModal" tabindex="-1" aria-labelledby="newProductModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="newProductModalLabel">Add New Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div id="newProductForm">
      </div>
    </div>
  </div>
</div>


<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editProductModalLabel">Update Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div id="editProductForm">
      </div>
    </div>
  </div>
</div>


<div class="modal fade" id="showProductModal" tabindex="-1" aria-labelledby="showProductModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="showProductModalLabel">Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div id="showProductDetails">
      </div>
    </div>
  </div>
</div>
